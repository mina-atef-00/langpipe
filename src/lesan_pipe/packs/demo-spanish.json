  "grammar": [
    {
      "name": "ser (permanent to be)",
      "stage": 1,
      "explanation": "Ser describes permanent qualities and identity.",
      "examples": [
        {"prompt": "Complete: Yo ___ estudiante.", "answer": "soy"},
        {"prompt": "Complete: Él ___ alto.", "answer": "es"}
      ]
    },
    {
      "name": "noun-adjective agreement",
      "stage": 1,
      "explanation": "Adjectives agree in gender and number with their noun.",
      "examples": [
        {"prompt": "Complete: la casa ___ (small)", "answer": "pequeña"},
        {"prompt": "Complete: el libro ___ (red)", "answer": "rojo"}
      ]
    },
    {
      "name": "present tense of -ar verbs",
      "stage": 2,
      "explanation": "Regular -ar verbs drop -ar and add -o, -as, -a.",
      "examples": [
        {"prompt": "Complete: Yo ___ (hablar) español.", "answer": "hablo"},
        {"prompt": "Complete: Tú ___ (trabajar) mucho.", "answer": "trabajas"}
      ]
    },
    {
      "name": "gustar",
      "stage": 2,
      "explanation": "Gustar means 'to be pleasing'; the liked thing is the subject.",
      "examples": [
        {"prompt": "Translate: I like the book.", "answer": "Me gusta el libro."},
        {"prompt": "Translate: I like dogs.", "answer": "Me gustan los perros."}
      ]
    },
    {
      "name": "tener que + infinitive",
      "stage": 3,
      "explanation": "Tener que expresses obligation ('have to').",
      "examples": [
        {"prompt": "Translate: I have to work.", "answer": "Tengo que trabajar."},
        {"prompt": "Translate: You have to eat.", "answer": "Tienes que comer."}
      ]
    },
    {
      "name": "direct object pronouns",
      "stage": 3,
      "explanation": "Lo/la replace a direct object.",
      "examples": [
        {"prompt": "Translate: I eat it (the bread).", "answer": "Lo como."},
        {"prompt": "Translate: I see it (the house).", "answer": "La veo."}
      ]
    },
    {
      "name": "present subjunctive",
      "stage": 4,
      "explanation": "Expresses wishes and doubt; -ar verbs take -e endings.",
      "examples": [
        {"prompt": "Complete: Quiero que tú ___ (hablar) conmigo.", "answer": "hables"},
        {"prompt": "Complete: Espero que él ___ (trabajar) mañana.", "answer": "trabaje"}
      ]
    },
    {
      "name": "present perfect",
      "stage": 4,
      "explanation": "Haber plus a past participle.",
      "examples": [
        {"prompt": "Complete: Yo ___ comido.", "answer": "he"},
        {"prompt": "Translate: I have eaten.", "answer": "He comido."}
      ]
    }
  ]
